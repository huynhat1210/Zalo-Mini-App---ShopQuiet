generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  BANNED
}

enum OrderStatus {
  PENDING_PAYMENT
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  COMPLETED
  RETURN_REQUESTED
  RETURNED
  CANCELLED
  REFUNDED
}

enum AuthProvider {
  ZALO
  GOOGLE
  FACEBOOK
  EMAIL
  KEYCLOAK
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  EXPIRED
  REFUNDED
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String
  slug        String    @unique
  description String?
  imageUrl    String?
  products    Product[]
}

model Product {
  id                Int              @id @default(autoincrement())
  name              String
  description       String
  price             Decimal          @db.Decimal(12, 2)
  tags              String?
  images            Json
  categoryId        Int
  materialCare      String?
  shippingReturn    String?
  sizeChart         Json?
  isFlashSale       Boolean          @default(false)
  flashSalePrice    Decimal?         @db.Decimal(12, 2)
  flashSaleDiscount Int?
  soldCount         Int              @default(0)
  likeCount         Int              @default(0)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @default(now()) @updatedAt
  approvalStatus    String           @default("APPROVED")
  approvedAt        DateTime?
  approvedBy        String?
  cartItems         CartItem[]
  comments          Comment[]
  favorites         Favorite[]
  orderItems        OrderItem[]
  category          Category         @relation(fields: [categoryId], references: [id])
  variants          ProductVariant[]
  analyticsEvents   AnalyticsEvent[]

  @@index([categoryId])
  @@index([name])
  @@index([createdAt])
  @@index([price])
  @@index([isFlashSale])
  @@index([soldCount])
}

model User {
  zaloId             String         @id
  name               String
  avatar             String?
  role               UserRole       @default(USER)
  status             UserStatus     @default(ACTIVE)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  birthday           DateTime?
  gender             String?
  phone              String?        @unique
  email              String?        @unique
  totalSpent         Decimal        @default(0) @db.Decimal(12, 2)
  membershipTier     String         @default("Đồng")
  gamificationPoints Decimal        @default(0) @db.Decimal(10, 0)
  height             Float?
  weight             Float?
  footLength         Float?
  clothingSize       String?
  shoeSize           String?
  lastLoginAt        DateTime?
  emailVerifiedAt    DateTime?
  phoneVerifiedAt    DateTime?
  termsAcceptedAt    DateTime?
  marketingConsentAt DateTime?
  deletedAt          DateTime?
  provider           AuthProvider   @default(ZALO)
  providerSubject    String?        @unique
  keycloakUserId     String?        @unique
  providerVerifiedAt DateTime?

  cartItems      CartItem[]
  comments       Comment[]
  favorites      Favorite[]
  notifications  Notification[]
  orders         Order[]
  addresses      UserAddress[]
  chatMessages   ChatMessage[]
  pointsHistory  PointsHistory[]
  campaignUsers  CampaignUser[]
  automationLogs AutomationLog[]
  authSessions   AuthSession[]

  @@index([name])
  @@index([role])
  @@index([status])
  @@index([createdAt])
}

model AuthSession {
  id         String    @id @default(uuid())
  zaloUserId String
  tokenHash  String    @unique
  deviceInfo String?
  ipAddress  String?
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [zaloUserId], references: [zaloId], onDelete: Cascade)

  @@index([zaloUserId])
  @@index([expiresAt])
}

model CartItem {
  id         Int      @id @default(autoincrement())
  zaloUserId String
  productId  Int
  color      String   @default("DEFAULT")
  size       String   @default("DEFAULT")
  quantity   Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [zaloUserId], references: [zaloId], onDelete: Cascade)

  @@unique([zaloUserId, productId, color, size])
}

model ProductVariant {
  id         Int     @id @default(autoincrement())
  productId  Int
  color      String  @default("DEFAULT")
  colorImage String?
  size       String  @default("DEFAULT")
  stock      Int     @default(0)
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, color, size])
}

model Comment {
  id         Int      @id @default(autoincrement())
  productId  Int
  zaloUserId String
  content    String
  rating     Int      @default(5)
  orderId    String?
  images     Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  approvalStatus String  @default("APPROVED")
  approvedAt DateTime?
  approvedBy String?
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [zaloUserId], references: [zaloId], onDelete: Cascade)

  @@unique([orderId, productId])
  @@index([productId])
  @@index([zaloUserId])
  @@index([rating])
  @@index([createdAt])
}

model UserAddress {
  id        Int      @id @default(autoincrement())
  zaloUserId String
  label     String
  phone     String
  street    String
  city      String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [zaloUserId], references: [zaloId], onDelete: Cascade)

  @@index([zaloUserId])
}

model Order {
  id                  String               @id
  totalAmount         Decimal              @db.Decimal(12, 2)
  status              OrderStatus          @default(PROCESSING)
  zaloUserId          String?
  createdAt           DateTime             @default(now())
  paymentMethod       String               @default("COD")
  voucherCode         String?
  discountAmount      Decimal              @default(0) @db.Decimal(12, 2)
  shippingAddress     String?
  shippingPhone       String?
  shippingName        String?
  trackingNumber      String?
  returnReason        String?
  returnDescription   String?
  returnImages        Json?
  estimatedDeliveryDate DateTime?
  shippingMethodCode  String?
  user                User?                @relation(fields: [zaloUserId], references: [zaloId])
  items               OrderItem[]
  paymentTransactions PaymentTransaction[]

  @@index([zaloUserId])
  @@index([status])
  @@index([createdAt])
  @@index([paymentMethod])
  @@index([estimatedDeliveryDate])
  @@index([zaloUserId, createdAt])
  @@index([status, createdAt])
}

model OrderItem {
  id              Int      @id @default(autoincrement())
  quantity        Int
  price           Decimal  @db.Decimal(12, 2)
  productId       Int
  color           String   @default("DEFAULT")
  size            String   @default("DEFAULT")
  productName     String?
  productImageUrl String?
  orderId         String
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product         Product  @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

model PaymentTransaction {
  id              String        @id @default(uuid())
  orderId         String
  transactionCode String        @unique
  provider        String        @default("PAY2S")
  amount          Decimal       @db.Decimal(12, 2)
  currency        String        @default("VND")
  status          PaymentStatus @default(PENDING)
  rawResponse     Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
  @@index([provider])
}

model PaymentWebhookEvent {
  id             String    @id @default(uuid())
  provider       String    @default("PAY2S")
  eventId        String?   @unique
  idempotencyKey String?   @unique
  eventType      String
  payload        Json
  processed      Boolean   @default(false)
  processedAt    DateTime?
  errorMessage   String?
  createdAt      DateTime  @default(now())

  @@index([provider])
  @@index([processed])
  @@index([createdAt])
}

model Notification {
  id         Int      @id @default(autoincrement())
  zaloUserId String?
  title      String
  content    String
  type       String
  date       String
  read       Boolean  @default(false)
  status     String   @default("SENT")
  scheduledAt DateTime?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [zaloUserId], references: [zaloId], onDelete: Cascade)

  @@index([zaloUserId])
  @@index([read])
  @@index([type])
  @@index([date])
  @@index([createdAt])
  @@index([zaloUserId, read, createdAt])
  @@index([status, scheduledAt])
}

model Favorite {
  id         Int      @id @default(autoincrement())
  zaloUserId String
  productId  Int
  createdAt  DateTime @default(now())
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [zaloUserId], references: [zaloId], onDelete: Cascade)

  @@unique([zaloUserId, productId])
  @@index([productId])
  @@index([createdAt])
}

model Voucher {
  code        String    @id
  type        String
  value       Decimal   @db.Decimal(12, 2)
  minOrderVal Decimal   @default(0) @db.Decimal(12, 2)
  maxDiscount Decimal?  @db.Decimal(12, 2)
  stock       Int       @default(999)
  usedCount   Int       @default(0)
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([type])
  @@index([stock])
  @@index([expiresAt])
  @@index([createdAt])
}

model Banner {
  id          Int      @id @default(autoincrement())
  imageUrl    String
  tag         String?
  title       String?
  description String?
  cta         String?
  link        String?
  active      Boolean  @default(true)
  approvalStatus String  @default("APPROVED")
  approvedAt DateTime?
  approvedBy String?
  createdAt   DateTime @default(now())
}

model MembershipPrivilege {
  id          Int      @id @default(autoincrement())
  tier        String
  title       String
  description String
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@unique([tier, title])
  @@index([tier])
}

model SiteSetting {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  label       String
  value       String
  type        String   @default("TEXT")
  group       String   @default("general")
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model MenuItem {
  id          Int      @id @default(autoincrement())
  section     String   @default("collections")
  label       String
  targetType  String   @default("CATEGORY")
  target      String?
  description String?
  imageUrl    String?
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ShippingMethod {
  id            Int      @id @default(autoincrement())
  code          String   @unique
  name          String
  description   String?
  price         Decimal  @default(0) @db.Decimal(12, 2)
  estimatedDays String?
  sortOrder     Int      @default(0)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model PaymentMethod {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  name        String
  description String?
  provider    String?
  badge       String?
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ChatMessage {
  id         Int      @id @default(autoincrement())
  zaloUserId String
  sender     String
  content    String
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [zaloUserId], references: [zaloId], onDelete: Cascade)

  @@index([zaloUserId])
  @@index([createdAt])
  @@index([zaloUserId, createdAt])
  @@index([zaloUserId, sender, read])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  adminId   String   @default("admin-default")
  action    String
  details   String
  createdAt DateTime @default(now())
}

model SystemLog {
  id        Int      @id @default(autoincrement())
  level     String   @default("ERROR")
  method    String
  path      String
  statusCode Int
  message   String
  requestId String?
  traceId   String?
  createdAt DateTime @default(now())

  @@index([level, createdAt])
  @@index([statusCode, createdAt])
  @@index([path, createdAt])
}

model AnalyticsEvent {
  id         Int      @id @default(autoincrement())
  zaloUserId String
  eventType  String
  productId  Int?
  categoryId Int?
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now())

  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([zaloUserId])
  @@index([eventType])
  @@index([productId])
  @@index([eventType, productId])
  @@index([createdAt])
  @@index([eventType, createdAt])
  @@index([zaloUserId, createdAt])
}

model PointsHistory {
  id         Int      @id @default(autoincrement())
  zaloUserId String
  points     Int
  reason     String
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now())

  user User @relation(fields: [zaloUserId], references: [zaloId], onDelete: Cascade)

  @@index([zaloUserId])
  @@index([createdAt])
}

model Campaign {
  id               Int            @id @default(autoincrement())
  title            String
  description      String?
  type             String
  targetSegment    String         @default("ALL")
  voucherCode      String?
  bonusCoins       Int            @default(0)
  discountPercent  Int            @default(0)
  status           String         @default("DRAFT")
  approvalStatus   String         @default("NOT_REQUIRED")
  approvedAt       DateTime?
  approvedBy       String?
  experimentKey    String?
  variantLabel     String?
  dailyLimit       Int            @default(1)
  quietHoursStart  Int            @default(22)
  quietHoursEnd    Int            @default(7)
  scheduledAt      DateTime?
  startedAt        DateTime?
  endedAt          DateTime?
  totalTargeted    Int            @default(0)
  totalOpened      Int            @default(0)
  totalConverted   Int            @default(0)
  revenueGenerated Decimal        @default(0) @db.Decimal(12, 2)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @default(now()) @updatedAt
  users            CampaignUser[]
  histories        CampaignHistory[]

  @@index([status])
  @@index([type])
  @@index([createdAt])
  @@index([approvalStatus])
  @@index([experimentKey])
}

model CampaignUser {
  id          Int       @id @default(autoincrement())
  campaignId  Int
  zaloUserId  String
  isOpened    Boolean   @default(false)
  isConverted Boolean   @default(false)
  openedAt    DateTime?
  createdAt   DateTime  @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [zaloUserId], references: [zaloId], onDelete: Cascade)

  @@unique([campaignId, zaloUserId])
  @@index([zaloUserId])
}

model CampaignHistory {
  id         Int      @id @default(autoincrement())
  campaignId Int
  action     String
  actorId    String?
  details    Json     @default("{}")
  createdAt  DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, createdAt])
  @@index([action])
}

model CampaignTemplate {
  id              Int      @id @default(autoincrement())
  name            String
  description     String?
  type            String
  targetSegment   String   @default("ALL")
  content         String
  voucherCode     String?
  bonusCoins      Int      @default(0)
  discountPercent Int      @default(0)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([active])
  @@index([type])
  @@index([createdAt])
}

model Automation {
  id          Int             @id @default(autoincrement())
  name        String
  description String?
  trigger     String
  actions     Json
  conditions  Json            @default("{}")
  enabled     Boolean         @default(true)
  priority    Int             @default(0)
  metadata    Json            @default("{}")
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  logs        AutomationLog[]

  @@index([trigger])
  @@index([enabled])
  @@index([priority])
  @@index([createdAt])
  @@index([trigger, enabled, priority])
}

model AutomationLog {
  id           Int       @id @default(autoincrement())
  automationId Int
  zaloUserId   String
  status       String
  triggeredAt  DateTime  @default(now())
  executedAt   DateTime?
  errorMessage String?
  result       Json      @default("{}")
  metadata     Json      @default("{}")

  automation Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [zaloUserId], references: [zaloId], onDelete: Cascade)

  @@index([automationId])
  @@index([zaloUserId])
  @@index([status])
  @@index([triggeredAt])
  @@index([automationId, zaloUserId, status])
}

model AutomationTemplate {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  category    String
  trigger     String
  actions     Json
  conditions  Json     @default("{}")
  isSystem    Boolean  @default(false)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([active])
  @@index([isSystem])
}

model MarketingList {
  id          Int                  @id @default(autoincrement())
  name        String
  description String?
  sourceType  String               @default("PASTE")
  sourceId    String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  entries     MarketingListEntry[]

  @@index([createdAt])
}

model MarketingListEntry {
  id        Int           @id @default(autoincrement())
  listId    Int
  phone     String
  name      String?
  zaloUid   String?
  hasZalo   Boolean       @default(false)
  status    String        @default("PENDING")
  createdAt DateTime      @default(now())
  list      MarketingList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@unique([listId, phone])
}
