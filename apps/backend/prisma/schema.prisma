generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String
  slug        String    @unique
  description String?
  imageUrl    String?
  products    Product[]
}

model Product {
  id             Int              @id @default(autoincrement())
  name           String
  description    String
  price          Float
  tags           String?
  images         String
  categoryId     Int
  materialCare   String?
  shippingReturn String?
  sizeChart      String?          // JSON: [{size, height, weight, bust, waist}]
  isFlashSale    Boolean          @default(false)
  flashSalePrice Float?
  flashSaleDiscount Int?
  soldCount      Int              @default(0)
  likeCount      Int              @default(0)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @default(now()) @updatedAt
  cartItems      CartItem[]
  comments       Comment[]
  favorites      Favorite[]
  orderItems     OrderItem[]
  category       Category         @relation(fields: [categoryId], references: [id])
  variants       ProductVariant[]
  analyticsEvents AnalyticsEvent[]

  @@index([categoryId])
  @@index([name])
  @@index([createdAt])
  @@index([price])
  @@index([isFlashSale])
  @@index([soldCount])
}


model User {
  zaloId        String         @id
  name          String
  avatar        String?
  role          String         @default("user")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  birthday      String?
  gender        String?
  phone         String?
  email         String?
  totalSpent     Float          @default(0)
  membershipTier String         @default("Đồng")
  gamificationPoints Float      @default(0)
  height            Float?
  weight            Float?
  footLength        Float?
  clothingSize      String?
  shoeSize          String?
  refreshToken      String?        @unique
  refreshTokenExpiresAt DateTime?
  password          String?
  resetOtp          String?
  resetOtpExpiresAt DateTime?
  cartItems     CartItem[]
  comments      Comment[]
  favorites     Favorite[]
  notifications Notification[]
  orders        Order[]
  addresses     UserAddress[]
  chatMessages  ChatMessage[]
  pointsHistory PointsHistory[]
  campaignUsers CampaignUser[]

  @@index([name])
  @@index([role])
  @@index([createdAt])
  @@index([email])
  @@index([phone])
}

model CartItem {
  id         Int      @id @default(autoincrement())
  zaloUserId String
  productId  Int
  color      String   @default("DEFAULT")
  size       String   @default("DEFAULT")
  quantity   Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [zaloUserId], references: [zaloId], onDelete: Cascade)

  @@unique([zaloUserId, productId, color, size])
}

model ProductVariant {
  id         Int     @id @default(autoincrement())
  productId  Int
  color      String  @default("DEFAULT")
  colorImage String?
  size       String  @default("DEFAULT")
  stock      Int     @default(0)
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, color, size])
}

model Comment {
  id         Int      @id @default(autoincrement())
  productId  Int
  zaloUserId String
  content    String
  rating     Int      @default(5)
  orderId    String?
  images     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [zaloUserId], references: [zaloId], onDelete: Cascade)

  @@unique([orderId, productId])
  @@index([productId])
  @@index([zaloUserId])
  @@index([rating])
  @@index([createdAt])
}

model UserAddress {
  id         Int     @id @default(autoincrement())
  zaloUserId String
  label      String
  phone      String
  street     String
  city       String
  isDefault  Boolean @default(false)
  user       User    @relation(fields: [zaloUserId], references: [zaloId], onDelete: Cascade)
}

model Order {
  id              String      @id
  totalAmount     Float
  status          String      @default("PROCESSING")
  zaloUserId      String?
  createdAt       DateTime    @default(now())
  paymentMethod   String      @default("COD")
  voucherCode     String?
  discountAmount  Float       @default(0)
  shippingAddress String?
  shippingPhone   String?
  shippingName    String?
  trackingNumber  String?
  returnReason      String?
  returnDescription String?
  returnImages      String? // JSON string array of proof images
  estimatedDeliveryDate DateTime?
  shippingMethodCode String?
  user            User?       @relation(fields: [zaloUserId], references: [zaloId])
  items           OrderItem[]

  @@index([zaloUserId])
  @@index([status])
  @@index([createdAt])
  @@index([paymentMethod])
  @@index([estimatedDeliveryDate])
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  quantity  Int
  price     Float
  productId Int
  color     String  @default("DEFAULT")
  size      String  @default("DEFAULT")
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])
}

model Notification {
  id         Int      @id @default(autoincrement())
  zaloUserId String?
  title      String
  content    String
  type       String
  date       String
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [zaloUserId], references: [zaloId], onDelete: Cascade)

  @@index([zaloUserId])
  @@index([read])
  @@index([type])
  @@index([date])
  @@index([createdAt])
}

model Favorite {
  id         Int      @id @default(autoincrement())
  zaloUserId String
  productId  Int
  createdAt  DateTime @default(now())
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [zaloUserId], references: [zaloId], onDelete: Cascade)

  @@unique([zaloUserId, productId])
  @@index([zaloUserId])
  @@index([productId])
  @@index([createdAt])
}

model Voucher {
  code        String    @id
  type        String
  value       Float
  minOrderVal Float     @default(0)
  maxDiscount Float?
  stock       Int       @default(999)
  usedCount   Int       @default(0)
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([type])
  @@index([stock])
  @@index([expiresAt])
  @@index([createdAt])
}

model Banner {
  id          Int      @id @default(autoincrement())
  imageUrl    String
  tag         String?
  title       String?
  description String?
  cta         String?
  link        String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model MembershipPrivilege {
  id          Int      @id @default(autoincrement())
  tier        String   // 'Đồng', 'Bạc', 'Vàng', 'Kim cương'
  title       String
  description String
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@unique([tier, title])
  @@index([tier])
}

model SiteSetting {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  label       String
  value       String
  type        String   @default("TEXT")
  group       String   @default("general")
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model MenuItem {
  id          Int      @id @default(autoincrement())
  section     String   @default("collections")
  label       String
  targetType  String   @default("CATEGORY")
  target      String?
  description String?
  imageUrl    String?
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ShippingMethod {
  id            Int      @id @default(autoincrement())
  code          String   @unique
  name          String
  description   String?
  price         Float    @default(0)
  estimatedDays String?
  sortOrder     Int      @default(0)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model PaymentMethod {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  name        String
  description String?
  provider    String?
  badge       String?
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ChatMessage {
  id         Int      @id @default(autoincrement())
  zaloUserId String
  sender     String   // "USER" or "ADMIN"
  content    String
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [zaloUserId], references: [zaloId], onDelete: Cascade)

  @@index([zaloUserId])
  @@index([createdAt])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  adminId   String   @default("admin-default")
  action    String
  details   String
  createdAt DateTime @default(now())
}

model AnalyticsEvent {
  id         Int      @id @default(autoincrement())
  zaloUserId String
  eventType  String   // "view", "click", "add_to_cart", "purchase", "search", "filter", "share"
  productId  Int?
  categoryId Int?
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now())

  product    Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([zaloUserId])
  @@index([eventType])
  @@index([productId])
  @@index([eventType, productId])
  @@index([createdAt])
}

model PointsHistory {
  id         Int      @id @default(autoincrement())
  zaloUserId String
  points     Int
  reason     String
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [zaloUserId], references: [zaloId], onDelete: Cascade)

  @@index([zaloUserId])
  @@index([createdAt])
}

model Campaign {
  id              Int            @id @default(autoincrement())
  title           String
  description     String?
  type            String         // 'VOUCHER', 'BONUS_COINS', 'BROADCAST', 'FLASH_SALE'
  targetSegment   String         @default("ALL") // 'ALL', 'SILVER', 'GOLD', 'DIAMOND', 'INACTIVE_30_DAYS', 'VIP'
  voucherCode     String?
  bonusCoins      Int            @default(0)
  discountPercent Int            @default(0)
  status          String         @default("DRAFT") // 'DRAFT', 'SCHEDULED', 'RUNNING', 'COMPLETED', 'CANCELLED'
  scheduledAt     DateTime?
  startedAt       DateTime?
  endedAt         DateTime?
  totalTargeted   Int            @default(0)
  totalOpened     Int            @default(0)
  totalConverted  Int            @default(0)
  revenueGenerated Float         @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @default(now()) @updatedAt
  users           CampaignUser[]

  @@index([status])
  @@index([type])
  @@index([createdAt])
}

model CampaignUser {
  id          Int      @id @default(autoincrement())
  campaignId  Int
  zaloUserId  String
  isOpened    Boolean  @default(false)
  isConverted Boolean  @default(false)
  openedAt    DateTime?
  createdAt   DateTime @default(now())

  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [zaloUserId], references: [zaloId], onDelete: Cascade)

  @@unique([campaignId, zaloUserId])
  @@index([zaloUserId])
  @@index([campaignId])
}
