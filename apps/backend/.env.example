NODE_ENV=development
HOST=0.0.0.0
PORT=3000
APP_BASE_URL=http://localhost:3000
# Optional in production: comma-separated trusted web origins.
# Leave unset for local development and a temporary tunnel.

DATABASE_URL="postgresql://postgres:<password>@127.0.0.1:5432/shopquiet_local?schema=public"
DIRECT_URL="postgresql://postgres:<password>@127.0.0.1:5432/shopquiet_local?schema=public"

KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=shopquiet
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=<keycloak-admin-password>
KEYCLOAK_USER_PASSWORD_SECRET=<random-long-secret>

JWT_SECRET=<random-long-secret>
ADMIN_PASSWORD_HASH=<bcrypt-password-hash>
ZALO_APP_SECRET=<zalo-app-secret>
ZALO_PAYMENT_PRIVATE_KEY=<zalo-payment-private-key>
PAY2S_IPN_SECRET=<random-long-secret>
PAY2S_HOOK_SECRET=<random-long-secret>

CLOUDINARY_CLOUD_NAME=<cloud-name>
CLOUDINARY_API_KEY=<api-key>
CLOUDINARY_API_SECRET=<api-secret>
