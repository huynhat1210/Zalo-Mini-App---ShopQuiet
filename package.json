{
  "name": "zalo-ecommerce-monorepo",
  "version": "1.0.0",
  "packageManager": "pnpm@11.20.0",
  "description": "Zalo Mini App E-Commerce Monorepo Architecture",
  "private": true,
  "scripts": {
    "dev:backend": "pnpm --filter backend dev",
    "dev:crm": "pnpm --filter zalo-crm-backend dev",
    "dev:crm-fe": "pnpm --filter zalo-crm-frontend dev",
    "dev:frontend": "pnpm --filter frontend dev",
    "dev:zalo": "pnpm --filter zalo-mini-app dev",
    "dev:cms": "pnpm --filter cms dev",
    "dev:admin": "pnpm --filter admin-cms dev",
    "dev": "pnpm run --parallel dev",
    "build": "pnpm run --recursive build",
    "lint": "pnpm run --recursive lint",
    "db:generate": "pnpm --filter backend db:generate",
    "db:migrate": "pnpm --filter backend db:migrate",
    "db:migrate:dev": "pnpm --filter backend db:migrate:dev",
    "db:seed": "pnpm --filter backend db:seed",
    "db:push": "pnpm --filter backend db:push",
    "db:studio": "pnpm --filter backend db:studio",
    "tunnel": "node scripts/start-tunnel.js",
    "tunnel:quick": "node scripts/start-tunnel.js",
    "start:local": "node scripts/start-local.js",
    "start:docker": "node scripts/start-docker.js",
    "docker:up": "docker compose up -d --build backend crm-backend keycloak",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f backend crm-backend keycloak"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "react-pull-to-refresh": "^2.0.1"
  }
}
